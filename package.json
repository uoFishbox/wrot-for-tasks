{
  "name": "wrot-for-tasks",
  "version": "3.1.0-task.3",
  "description": "Daily notes, timed tasks, and a remaining-tasks timeline, based on Wrot.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "test:calendar": "node --test scripts/test-calendar-tasks.mjs",
    "test:remaining-task-time": "node --test scripts/test-remaining-task-time.mjs",
    "test:i18n-pack": "node --test scripts/test-i18n-pack.mjs",
    "test:time-task": "node --test scripts/test-time-task.mjs",
    "test:date-shift": "node --test scripts/test-date-shift.mjs",
    "test:date-post": "node --test scripts/test-date-post.mjs",
    "test:composer-suggest": "node --test scripts/test-composer-suggest.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "obsidian": "^1.14.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "obsidian-daily-notes-interface": "^0.9.5"
  }
}
