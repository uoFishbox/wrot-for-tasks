{
  "name": "wrot",
  "version": "3.1.0",
  "description": "Micro-journal your day in a timeline, one \"tweet\" at a time.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "test:calendar": "node --test scripts/test-calendar-tasks.mjs",
    "test:time-task": "node --test scripts/test-time-task.mjs",
    "test:time-suggest": "node --test scripts/test-time-suggest.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "obsidian": "^1.14.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "obsidian-daily-notes-interface": "^0.9.5"
  }
}
